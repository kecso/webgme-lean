// Statechart domain constraints.
// The vocabulary is the META of examples/statechart/statechart.webgmex:
// StateChart contains Init, State, and Transition. Init and End specialize State.
// Transition.event and Transition.guard are attributes. src and dst point at State.

constraintset StatechartConstraints for StateChart

define reachable(src, dst) = reachableVia(src, dst, Transition, "src", "dst")

define hasOutgoing(s) = !isEmpty(pointingTo(s, Transition, "src"))
define hasIncoming(s) = !isEmpty(pointingTo(s, Transition, "dst"))

constraint UniqueStateNames [error]
forall s1 in State:
  forall s2 in State where s1.name == s2.name:
    s1 == s2

constraint InitialStateExists [error]
exists i in Init:
  true

constraint TransitionHasSource [error]
forall t in Transition:
  t->src != null

constraint TransitionHasTarget [error]
forall t in Transition:
  t->dst != null

constraint NoSelfLoopOnInitial [warning]
forall t in Transition:
  forall i in Init:
    (t->src == i and t->dst == i) implies false

constraint EndStateNoOutgoing [warning]
forall t in Transition:
  forall e in End:
    t->src != e

constraint AllStatesReachable [error]
forall target in State:
  exists initial in Init:
    reachable(initial, target) or initial == target

constraint NoDuplicateTransitions [warning]
forall t1 in Transition:
  forall t2 in Transition where t1->src == t2->src and t1->dst == t2->dst and t1.event == t2.event:
    t1 == t2
